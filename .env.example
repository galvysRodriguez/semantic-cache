# Copia este archivo a .env. Sin ninguna API key se usa un LLM simulado.
# Grok (xAI): https://console.x.ai — tiene prioridad si también hay clave de Gemini.
XAI_API_KEY=
SEMCACHE_XAI_MODEL=grok-4.3

# Alternativa: Gemini (si usas Gemini, ajusta los precios de abajo a 0.30 / 2.50).
GEMINI_API_KEY=
SEMCACHE_GEMINI_MODEL=gemini-2.5-flash

SEMCACHE_REDIS_URL=redis://localhost:6379/0
SEMCACHE_SIMILARITY_THRESHOLD=0.95
SEMCACHE_TTL_SECONDS=3600
SEMCACHE_ROUTE_TTLS={}
SEMCACHE_CACHED_PATHS=["/ask"]
SEMCACHE_TENANT_HEADER=x-tenant-id
SEMCACHE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Precio USD por millón de tokens, para estimar el ahorro (revisa la tarifa vigente).
SEMCACHE_PRICE_INPUT_PER_MTOK=1.25
SEMCACHE_PRICE_OUTPUT_PER_MTOK=2.50
