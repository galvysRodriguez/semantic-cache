# Copia este archivo a .env. Se usa el primer proveedor con clave: Groq, Grok (xAI), Gemini.
# Sin ninguna clave se usa un LLM simulado.

# Groq (groq.com, claves gsk_...): modelos abiertos, muy rápido y con capa gratuita.
GROQ_API_KEY=
SEMCACHE_GROQ_MODEL=openai/gpt-oss-20b

# Grok de xAI (x.ai, claves xai-...).
XAI_API_KEY=
SEMCACHE_XAI_MODEL=grok-4.3

# Gemini de Google.
GEMINI_API_KEY=
SEMCACHE_GEMINI_MODEL=gemini-2.5-flash

SEMCACHE_REDIS_URL=redis://localhost:6379/0
SEMCACHE_SIMILARITY_THRESHOLD=0.95
SEMCACHE_TTL_SECONDS=3600
SEMCACHE_ROUTE_TTLS={}
SEMCACHE_CACHED_PATHS=["/ask"]
SEMCACHE_TENANT_HEADER=x-tenant-id
SEMCACHE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# USD por millón de tokens, para estimar el ahorro. Sin definir se usa la tarifa del modelo
# por defecto del proveedor activo; descoméntalo solo si cambias de modelo.
# SEMCACHE_PRICE_INPUT_PER_MTOK=
# SEMCACHE_PRICE_OUTPUT_PER_MTOK=
